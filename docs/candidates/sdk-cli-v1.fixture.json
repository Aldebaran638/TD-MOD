{
  "schema": "cm2.creator-sdk-cli/1",
  "toolVersion": "cm2.sdk-cli/1.0.0-alpha.1",
  "commands": [ "init", "new", "validate", "build", "explain", "preview", "test", "package", "migrate", "doctor", "clean" ],
  "previewFixture": "docs/candidates/preview-suite-v1.fixture.json",
  "schemaPath": "schemas/cm2/source-envelope-v1.json",
  "compilerPath": "tools/cm2-compiler/compile-definitions.ps1",
  "toolLock": {
    "schema": "cm2.sdk-tool-lock/1",
    "tools": [
      { "name": "sdk-cli", "version": "1.0.0-alpha.1" },
      { "name": "asset-importer", "version": "1.0.0" },
      { "name": "definition-compiler", "version": "1.0.0" },
      { "name": "preview-builder", "version": "1.0.0" }
    ]
  },
  "newTemplate": {
    "packageId": "cm2.creator.hello-ship",
    "packageVersion": "0.1.0",
    "displayName": "Creator SDK Hello Ship",
    "license": "CC-BY-4.0",
    "sourceDirectories": [ "definitions", "assets", "generated" ],
    "runtimeLua": false
  },
  "cleanRoom": { "name": "hello-ship", "coreDiffExpected": 0, "requiresTeardownInstall": false, "dataOnly": true },
  "expected": {
    "stableErrorFields": [ "code", "packageId", "definitionId", "fieldPath", "suggestion" ],
    "buildOutputs": [ "manifest.json", "lock.json", "resources.json", "budget.json", "package.artifact.json", "package-report.json", "compiler-manifest.json", "compiler-report.json", "compiler-diagnostics.md", "fingerprint.sha256", "build-report.json" ],
    "failurePreservesLastValid": true,
    "editorIndependent": true,
    "repeatable": true
  },
  "negativeCases": [
    { "name": "invalid manifest blocks build", "expected": "validate-failed" },
    { "name": "shared Compiler blocks invalid definition", "expected": "compile-failed" },
    { "name": "private Runtime reference", "expected": "private-reference" },
    { "name": "incompatible Core or SDK range", "expected": "validate-failed" },
    { "name": "tool lock mismatch", "expected": "tool-version" },
    { "name": "generated drift", "expected": "generated-drift" },
    { "name": "preview missing", "expected": "preview-fixture" },
    { "name": "clean outside SDK root", "expected": "unsafe-clean" }
  ],
  "runtimeScope": "headless SDK contract; Teardown install is optional for data-only build and live preview deferred"
}
