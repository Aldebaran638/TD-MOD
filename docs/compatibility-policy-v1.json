{
  "schema": "cm2.compatibility-policy/1",
  "current": { "schemaMajor": 1, "coreApi": "1.x", "package": "1.x", "sdk": "1.x", "buildFormat": "cm2.package-build/1" },
  "supportMatrix": [
    { "surface": "source-envelope", "read": [ "cm2.weapon/1", "cm2.projectile/1", "cm2.effect/1", "cm2.vehicle/1", "cm2.mount/1", "cm2.turret/1" ], "write": "v1-only", "unknownOptional": "preserve-under-editor", "futureRequired": "fail-fast" },
    { "surface": "package", "read": [ "cm2.package/1" ], "write": "cm2.package/1", "unknownOptional": "preserve-under-provenance", "futureRequired": "fail-fast" },
    { "surface": "core-api", "read": [ "1.x" ], "write": "1.x", "unknownOptional": "ignore-at-runtime", "futureRequired": "fail-fast" },
    { "surface": "sdk", "read": [ "1.x" ], "write": "1.x", "unknownOptional": "preserve-in-source", "futureRequired": "fail-fast" }
  ],
  "negotiation": {
    "order": [ "package", "core-api", "schema", "build-format", "sdk" ],
    "rule": "Every surface must intersect its supported read range; a missing intersection is an actionable error and never a silent downgrade.",
    "minimumCore": "1.0.0",
    "maximumCoreExclusive": "2.0.0",
    "minimumPackage": "1.0.0",
    "maximumPackageExclusive": "2.0.0",
    "minimumSdk": "1.0.0",
    "maximumSdkExclusive": "2.0.0"
  },
  "readWritePolicy": {
    "oldSchemaRead": "migration adapter only",
    "currentSchemaWrite": "single canonical v1 writer",
    "unknownEditorMetadata": "round-trip without runtime projection",
    "unknownRuntimeField": "reject if required or security-sensitive; otherwise emit structured warning",
    "futureRequiredField": "reject before Compiler/Runtime",
    "migrationIdempotent": true
  },
  "migrations": [
    { "id": "cm2.source-envelope/0-to-1", "from": "major-0", "to": "major-1", "tool": "tools/cm2-compat/migrate-compat-v1.ps1", "idempotent": true, "singleWrite": true, "status": "supported" },
    { "id": "cm2.package/0-to-1", "from": "cm2.package/0", "to": "cm2.package/1", "tool": "tools/cm2-compat/migrate-compat-v1.ps1", "idempotent": true, "singleWrite": true, "status": "supported" }
  ],
  "deprecations": [
    { "id": "legacy.package-v0", "introduced": "0.x", "deprecatedIn": "1.0.0", "removeAfter": "2.0.0", "owner": "Build owner", "replacement": "cm2.package/1", "status": "warning-until-major-2" },
    { "id": "legacy.effect-type-alias", "introduced": "0.x", "deprecatedIn": "1.0.0", "removeAfter": "2.0.0", "owner": "Schema owner", "replacement": "runtime.effectType", "status": "migration-only" }
  ],
  "removalLedger": { "ownerRequired": true, "dateRequired": true, "replacementRequired": true, "evidenceRequired": true, "noSilentRemoval": true },
  "rollback": { "artifact": "previous valid package/build output", "policy": "Keep old reader and migration tool until removeAfter; revert migration output, never mutate the source in place." }
}
