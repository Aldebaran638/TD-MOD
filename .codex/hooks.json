{
  "description": "CM2 80-Step Todo continuation gate",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \".codex/hooks/check-todo-stop.ps1\"",
            "timeout": 30,
            "statusMessage": "Checking CM2 Todo completion before stopping"
          }
        ]
      }
    ]
  }
}
