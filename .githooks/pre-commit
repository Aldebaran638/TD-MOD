#!/usr/bin/env sh
# Run the repository Harness before allowing a commit.

set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"
if command -v wslpath >/dev/null 2>&1; then
    windows_root=$(wslpath -w "$repo_root")
elif pwd -W >/dev/null 2>&1; then
    windows_root=$(pwd -W)
else
    windows_root=$repo_root
fi

include_global=""
if git diff --cached --name-only -- "Global Mod/script" | grep -q .; then
    include_global="-IncludeGlobal"
fi

echo "Running project Harness before commit..."
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "if (-not (Get-Command rg -ErrorAction SilentlyContinue)) { \$env:PATH = (Join-Path \$env:LOCALAPPDATA 'Microsoft\WinGet\Links') + ';' + \$env:PATH }; & '$windows_root/harness/check-all.ps1' $include_global"
